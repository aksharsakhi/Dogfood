{
  "name": "dogfood",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @dogfood/api\" \"npm run dev -w @dogfood/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:import:official": "tsx prisma/import-official-fixtures.ts",
    "test:official:acceptance": "jest --config jest.official-acceptance.config.cjs --runInBand",
    "test:db": "tsx tests/database.integration.ts",
    "test:t3a:db": "tsx tests/t3a.database.integration.ts",
    "test:t3b": "jest --config jest.t3b.config.cjs --runInBand",
    "test:phase2": "jest --config jest.phase2.config.cjs --runInBand",
    "test:phase3": "jest --config jest.phase3.config.cjs --runInBand",
    "test:phase4a:stage1": "jest --config jest.phase4a.stage1.config.cjs --runInBand",
    "test:phase4a:stage2": "jest --config jest.phase4a.stage2.config.cjs --runInBand",
    "test:phase4a:stage3": "jest --config jest.phase4a.stage3.config.cjs --runInBand",
    "test:phase4b": "jest --config jest.phase4b.config.cjs --runInBand",
    "test:t4a": "jest --config jest.t4a.config.cjs --runInBand",
    "test:t4b": "jest --config jest.t4b.config.cjs --runInBand",
    "test:t4c": "jest --config jest.t4c.config.cjs --runInBand",
    "test:t4d": "jest --config jest.t4d.config.cjs --runInBand",
    "test:b1": "jest --config jest.b1.config.cjs --runInBand",
    "test:b3": "jest --config jest.b3.config.cjs --runInBand",
    "test:b4": "jest --config jest.b4.config.cjs --runInBand"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "@nestjs/platform-fastify": {
      "fastify": "5.12.5"
    }
  }
}
