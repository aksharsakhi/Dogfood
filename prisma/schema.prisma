/// Public verification material only. The corresponding private seed is deployment configuration and is never stored here.
model JudgeRecordSigningKey {
  id            String                     @id @db.VarChar(80)
  publicKeyPem  String                     @db.Text
  fingerprint   String                     @unique @db.Char(64)
  createdAt     DateTime                   @default(now()) @db.Timestamptz(6)
  retiredAt     DateTime?                  @db.Timestamptz(6)
  records       JudgeParticipationRecord[] @relation("JudgeParticipationRecord_issuerKeyId")
  revocations   JudgeRecordRevocation[]    @relation("JudgeRecordRevocation_issuerKeyId")
  rotationsFrom JudgeRecordKeyRotation[]   @relation("JudgeRecordKeyRotation_previousKeyId")
  rotationsTo   JudgeRecordKeyRotation[]   @relation("JudgeRecordKeyRotation_activeKeyId")

  @@index([retiredAt])
}

model JudgeRecordKeyRotation {
  id                  String                @id @default(uuid()) @db.Uuid
  previousKeyId       String                @db.VarChar(80)
  activeKeyId         String                @db.VarChar(80)
  previousFingerprint String                @db.Char(64)
  activeFingerprint   String                @db.Char(64)
  rotatedAt           DateTime              @default(now()) @db.Timestamptz(6)
  previousKey         JudgeRecordSigningKey @relation("JudgeRecordKeyRotation_previousKeyId", fields: [previousKeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeKey           JudgeRecordSigningKey @relation("JudgeRecordKeyRotation_activeKeyId", fields: [activeKeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([previousKeyId, activeKeyId])
  @@index([rotatedAt])
}

/// Event-specific random pseudonym shared by a judge's issued records.
model JudgeRecordSubject {
  id             String                     @id @default(uuid()) @db.Uuid
  eventId        String                     @db.Uuid
  judgeProfileId String                     @db.Uuid
  createdAt      DateTime                   @default(now()) @db.Timestamptz(6)
  event          Event                      @relation("JudgeRecordSubject_eventId", fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  judgeProfile   JudgeProfile               @relation("JudgeRecordSubject_judgeProfileId", fields: [judgeProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  records        JudgeParticipationRecord[] @relation("JudgeParticipationRecord_subjectId")

  @@unique([eventId, judgeProfileId])
  @@index([judgeProfileId])
}

/// Signed claims are append-only. Status is derived from revocation and superseding records.
model JudgeParticipationRecord {
  id                 String                    @id @default(uuid()) @db.Uuid
  eventId            String                    @db.Uuid
  judgeProfileId     String                    @db.Uuid
  subjectId          String                    @db.Uuid
  assignmentCount    Int
  evaluationCount    Int
  schemaVersion      Int                       @default(1)
  issuedAt           DateTime                  @db.Timestamptz(6)
  issuerKeyId        String                    @db.VarChar(80)
  canonicalPayload   String                    @db.Text
  signature          String                    @db.Text
  supersedesRecordId String?                   @unique @db.Uuid
  event              Event                     @relation("JudgeParticipationRecord_eventId", fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  judgeProfile       JudgeProfile              @relation("JudgeParticipationRecord_judgeProfileId", fields: [judgeProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subject            JudgeRecordSubject        @relation("JudgeParticipationRecord_subjectId", fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuerKey          JudgeRecordSigningKey     @relation("JudgeParticipationRecord_issuerKeyId", fields: [issuerKeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersedes         JudgeParticipationRecord? @relation("JudgeParticipationRecord_supersedes", fields: [supersedesRecordId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersededBy       JudgeParticipationRecord? @relation("JudgeParticipationRecord_supersedes")
  revocation         JudgeRecordRevocation?    @relation("JudgeRecordRevocation_recordId")

  @@index([eventId, judgeProfileId, issuedAt])
  @@index([subjectId])
}

/// A revocation is a separately signed immutable statement; it never rewrites the issued record.
model JudgeRecordRevocation {
  id               String                   @id @default(uuid()) @db.Uuid
  recordId         String                   @unique @db.Uuid
  issuerKeyId      String                   @db.VarChar(80)
  schemaVersion    Int                      @default(1)
  revokedAt        DateTime                 @db.Timestamptz(6)
  canonicalPayload String                   @db.Text
  signature        String                   @db.Text
  record           JudgeParticipationRecord @relation("JudgeRecordRevocation_recordId", fields: [recordId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuerKey        JudgeRecordSigningKey    @relation("JudgeRecordRevocation_issuerKeyId", fields: [issuerKeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model VotingIdentity {
  id              String           @id @default(uuid()) @db.Uuid
  eventId         String           @db.Uuid
  mode            VotingAccessMode
  userId          String?          @db.Uuid
  emailHash       String?          @db.Char(64)
  emailAcceptedAt DateTime?        @db.Timestamptz(6)
  /// A browser-held OPEN credential cannot prove one natural person.
  openTokenHash   String?          @db.Char(64)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  event           Event            @relation("VotingIdentity_event_mode", fields: [eventId, mode], references: [id, votingAccessMode], onDelete: Restrict, onUpdate: Restrict)
  user            User?            @relation("VotingIdentity_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  votes           CommunityVote[]  @relation("CommunityVote_identity_event")
  comments        ProjectComment[] @relation("ProjectComment_identity_event")

  @@unique([id, eventId])
  @@unique([eventId, userId])
  @@unique([eventId, emailHash])
  @@unique([eventId, openTokenHash])
  @@index([eventId, mode])
}

