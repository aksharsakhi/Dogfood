model WebhookDelivery {
  id             String                   @id @default(uuid()) @db.Uuid
  subscriptionId String                   @db.Uuid
  outboxEventId  String                   @db.Uuid
  status         WebhookDeliveryStatus    @default(PENDING)
  attempts       Int                      @default(0)
  cycleAttempts  Int                      @default(0)
  manualReplays  Int                      @default(0)
  nextAttemptAt  DateTime                 @default(now()) @db.Timestamptz(6)
  leaseUntil     DateTime?                @db.Timestamptz(6)
  leaseToken     String?                  @db.Uuid
  lastAttemptAt  DateTime?                @db.Timestamptz(6)
  lastHttpStatus Int?
  lastError      String?
  deliveredAt    DateTime?                @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)
