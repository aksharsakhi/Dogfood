model ScoreRun {
  id                       String            @id @default(uuid()) @db.Uuid
  eventId                  String            @db.Uuid
  status                   ScoreRunStatus    @default(CREATING)
  algorithm                String
  algorithmVersion         String
  method                   String            @default("Z_SCORE")
  methodVersion            String            @default("V1")
  parameters               Json              @db.JsonB
  rubricVersionId          String?           @db.Uuid
  inputEvaluationIds       String[]          @db.Uuid
  inputSetHash             String            @default("")
  coverageDiagnostics      Json?             @db.JsonB
  normalizationDiagnostics Json?             @db.JsonB
  completedAt              DateTime?         @db.Timestamptz(6)
  failedAt                 DateTime?         @db.Timestamptz(6)
  failureReason            String?
  createdById              String            @db.Uuid
  createdAt                DateTime          @default(now()) @db.Timestamptz(6)
  event                    Event             @relation("ScoreRun_eventId", fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy                User              @relation("ScoreRun_createdById", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rubric                   Rubric?           @relation("ScoreRun_rubricVersionId", fields: [rubricVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  normalizedScores         NormalizedScore[] @relation("NormalizedScore_scoreRunId")
  projectScores            ProjectScore[]    @relation("ProjectScore_scoreRunId")
  judgeStats               JudgeScoreStats[] @relation("JudgeScoreStats_scoreRunId")
  resultRuns               ResultRun[]       @relation("ResultRun_scoreRunId")

  @@unique([eventId, method, methodVersion, inputSetHash])
  @@index([eventId, createdAt])
  @@index([createdById])
}

