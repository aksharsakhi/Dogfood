# Caddy reverse proxy configuration for Dogfood platform
# Provides automated HTTPS certificate provisioning via Let's Encrypt / ZeroSSL

# Public web portal
{$DOMAIN:localhost} {
    encode zstd gzip

    # Direct API docs and OpenAPI specs
    handle /docs* {
        reverse_proxy localhost:4000
    }

    handle /openapi.json {
        reverse_proxy localhost:4000
    }

    handle /ready {
        reverse_proxy localhost:4000
    }

    handle /health {
        reverse_proxy localhost:4000
    }

    # All web portal and routed API endpoints
    handle {
        reverse_proxy localhost:3000
    }
}

# Optional dedicated API subdomain
api.{$DOMAIN:localhost} {
    encode zstd gzip

    handle {
        reverse_proxy localhost:4000
    }
}
